{
  "name": "timecraft",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TIMECRAFT - luxury watch e-commerce (MERN)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "typecheck": "npm run typecheck --workspace client"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
