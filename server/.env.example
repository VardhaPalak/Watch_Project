# Server
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/timecraft

# Auth (change before deploying)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@timecraft.com
ADMIN_PASSWORD=Timecraft@123

# CORS - comma separated list of allowed origins
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

# Business contact (used for WhatsApp links and email replies)
BUSINESS_WHATSAPP=
BUSINESS_PHONE=
BUSINESS_EMAIL=care@timecraft.com
BRAND_NAME=TIMECRAFT

# SMTP (server side only - never expose these in the client)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TIMECRAFT <no-reply@timecraft.com>"
ENQUIRY_TEAM_EMAIL=admin@timecraft.com

# Uploads
UPLOADS_DIR=uploads
